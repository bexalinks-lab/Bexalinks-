<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Please wait — Bexalink</title>
  <style>
    body { margin:0; background:#0B0A0C; color:#fff; font-family:-apple-system,Segoe UI,Inter,sans-serif;
           display:flex; flex-direction:column; align-items:center; min-height:100vh; }
    .brand { font-style:italic; font-size:22px; margin:24px 0 8px;
             background:linear-gradient(90deg,#F7E9B9,#F6C9A0,#F6A8E0); -webkit-background-clip:text; color:transparent; }
    .stage-label { color:#ffffff55; font-size:12px; letter-spacing:.04em; text-transform:uppercase; margin-bottom:8px; }
    .banner-slot { width:100%; max-width:728px; min-height:90px; margin:16px 0; display:flex;
                   align-items:center; justify-content:center; background:#16151A; border:1px solid #ffffff14; border-radius:8px; }
    .timer-box { text-align:center; margin:32px 0; }
    .timer-num { font-size:48px; font-weight:600; }
    .timer-label { color:#ffffff66; font-size:13px; margin-top:4px; }
    .dots { display:flex; gap:6px; margin-top:18px; }
    .dot { width:7px; height:7px; border-radius:50%; background:#ffffff22; }
    .dot.done { background:linear-gradient(90deg,#F7E9B9,#F6C9A0,#F6A8E0); }
  </style>
</head>
<body>
  <div class="brand">Bexalink</div>
  <% if ((totalStages || 1) > 1) { %>
    <div class="stage-label">Step <%= stage %> of <%= totalStages %></div>
  <% } %>

  <div class="banner-slot" id="banner-top">
    <% (adSlots || []).filter(a=>a.placement==='banner_top').forEach(a => { %>
      <%- a.script_code %>
    <% }) %>
  </div>

  <div class="timer-box">
    <div class="timer-num" id="countdown"><%= countdownSeconds %></div>
    <div class="timer-label">Your link will unlock in a few seconds</div>
    <% if ((totalStages || 1) > 1) { %>
      <div class="dots">
        <% for (let i = 1; i <= totalStages; i++) { %>
          <div class="dot<%= i < stage ? ' done' : '' %>"></div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="banner-slot" id="banner-bottom">
    <% (adSlots || []).filter(a=>a.placement==='banner_bottom').forEach(a => { %>
      <%- a.script_code %>
    <% }) %>
  </div>

  <!-- Popunder / Direct Link ads (e.g. an Adsterra Smartlink) don't render
       anything visible — they just open in a new tab once per page load. -->
  <% (adSlots || []).filter(a=>a.placement==='popunder').forEach(a => { %>
    <%- a.script_code %>
  <% }) %>

  <script>
    let remaining = <%= countdownSeconds %>;
    const el = document.getElementById('countdown');
    const timer = setInterval(() => {
      remaining -= 1;
      el.textContent = remaining;
      if (remaining <= 0) {
        clearInterval(timer);
        window.location.href = '<%- nextUrl %>';
      }
    }, 1000);
  </script>
</body>
</html>
