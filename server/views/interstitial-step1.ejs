<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Please wait — Bexalink</title>
  <style>
    :root {
      --ink: #1d1b2e; --ink-soft: #6b687a; --ink-faint: #9490a0;
    }
    * { box-sizing: border-box; }
    body {
      margin:0; min-height:100vh; overflow-x:hidden;
      font-family:-apple-system,Segoe UI,Inter,sans-serif; color:var(--ink);
      display:flex; flex-direction:column; align-items:center; padding:28px 16px 48px;
      background: linear-gradient(160deg, #e9e6ff 0%, #eef4ff 45%, #ffeef5 100%);
    }
    .brand { font-style:italic; font-size:24px; font-weight:600; margin:8px 0 6px;
             background:linear-gradient(90deg,#6366f1,#8b5cf6,#ec4899); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .stage-label { color:var(--ink-faint); font-size:12px; letter-spacing:.06em; text-transform:uppercase; margin-bottom:18px; font-weight:600; }
    .banner-slot { width:100%; max-width:520px; min-height:70px; margin:12px 0; padding:14px; overflow:hidden;
                   display:flex; flex-direction:column; align-items:center; gap:14px;
                   background:rgba(255,255,255,0.7); backdrop-filter:blur(10px);
                   border:1px solid rgba(255,255,255,0.9); border-radius:24px;
                   box-shadow: 0 8px 32px rgba(29,27,46,0.08); }
    .banner-slot > * { max-width:100%; box-sizing:border-box; }
    .timer-card { width:100%; max-width:520px; text-align:center; margin:16px 0; padding:28px 20px;
                  background:rgba(255,255,255,0.75); backdrop-filter:blur(10px);
                  border:1px solid rgba(255,255,255,0.9); border-radius:28px;
                  box-shadow: 0 12px 40px rgba(29,27,46,0.10); }
    .timer-num { font-size:52px; font-weight:800;
                 background:linear-gradient(90deg,#6366f1,#8b5cf6,#ec4899); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .timer-label { color:var(--ink-soft); font-size:13px; margin-top:6px; font-weight:500; }
    .dots { display:flex; gap:7px; justify-content:center; margin-top:16px; }
    .dot { width:8px; height:8px; border-radius:50%; background:#dcd9ea; }
    .dot.done { background:linear-gradient(90deg,#6366f1,#8b5cf6,#ec4899); }
    a.continue-btn { display:none; margin-top:8px; padding:15px 34px; border-radius:999px; font-weight:700; font-size:15px;
                 text-decoration:none; color:#fff; background:#151220; box-shadow:0 8px 20px rgba(21,18,32,0.25); }
    a.continue-btn.ready { display:inline-block; }
  </style>
</head>
<body>
  <div class="brand">Bexalink</div>
  <% if ((totalStages || 1) > 1) { %>
    <div class="stage-label">Step <%= stage %> of <%= totalStages %></div>
  <% } %>

  <div class="banner-slot" id="banner-top">
    <% (adSlots || []).filter(a=>a.placement==='banner_top').forEach(a => { %>
      <%- a.script_code %>
    <% }) %>
  </div>

  <div class="timer-card">
    <div id="countdown-wrap">
      <div class="timer-num" id="countdown"><%= countdownSeconds %></div>
      <div class="timer-label">Verification in progress — please don't close this window</div>
    </div>
    <a id="continue-btn" class="continue-btn" href="<%- nextUrl %>">Human Verification / Click To Continue</a>
    <% if ((totalStages || 1) > 1) { %>
      <div class="dots">
        <% for (let i = 1; i <= totalStages; i++) { %>
          <div class="dot<%= i < stage ? ' done' : '' %>"></div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="banner-slot" id="banner-bottom">
    <% (adSlots || []).filter(a=>a.placement==='banner_bottom').forEach(a => { %>
      <%- a.script_code %>
    <% }) %>
  </div>

  <!-- Popunder / Direct Link ads (e.g. an Adsterra Smartlink) don't render
       anything visible — they just open in a new tab once per page load. -->
  <% (adSlots || []).filter(a=>a.placement==='popunder').forEach(a => { %>
    <%- a.script_code %>
  <% }) %>

  <script>
    let remaining = <%= countdownSeconds %>;
    const el = document.getElementById('countdown');
    const timer = setInterval(() => {
      remaining -= 1;
      el.textContent = remaining;
      if (remaining <= 0) {
        clearInterval(timer);
        document.getElementById('countdown-wrap').style.display = 'none';
        document.getElementById('continue-btn').classList.add('ready');
      }
    }, 1000);
  </script>
</body>
</html>
